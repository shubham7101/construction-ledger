# JWT secret key (required, minimum 32 characters long)
# Generate one with: openssl rand -base64 48
JWT_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# Local file
DATABASE_URL=file:./local.db

# Or Turso
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-token

# First admin account, used once by `bun run db:seed`
# SEED_ADMIN_MOBILE=9876543210
# SEED_ADMIN_PASSWORD=change-me-now
